# ==============================================================================
# Self-Updating Knowledge Agent Configuration
# ==============================================================================

# --- Free LLM for Answer Generation (Google Gemini Free Tier) ---
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
KB_GEMINI_MODEL=gemini-3.6-flash

# --- Alternative LLM: Groq Free Tier ---
GROQ_API_KEY=
KB_GROQ_MODEL=openai/gpt-oss-120b

# --- Alternative LLM: OpenAI ---
OPENAI_API_KEY=
KB_OPENAI_MODEL=gpt-5-mini

# --- Optional Cloud Vector Store: Qdrant Cloud (1GB Free Tier) ---
# Leave blank to use embedded local Qdrant on disk (storage/qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# --- Optional Cloud Knowledge Graph: Neo4j AuraDB (Free Tier) ---
# Leave blank to use local NetworkX + JSON (storage/graph.json)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Pipeline Settings ---
# KB_OFFLINE=1  # Uncomment to force fast deterministic offline heuristics
